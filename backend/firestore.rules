rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function fullSession() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.jolSession is string
        && exists(/databases/$(database)/documents/authSessions/$(request.auth.token.jolSession))
        && exists(/databases/$(database)/documents/authState/$(request.auth.uid))
        && get(/databases/$(database)/documents/authSessions/$(request.auth.token.jolSession)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/authSessions/$(request.auth.token.jolSession)).data.revoked == false
        && get(/databases/$(database)/documents/authSessions/$(request.auth.token.jolSession)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/authSessions/$(request.auth.token.jolSession)).data.version == request.auth.token.jolVersion
        && get(/databases/$(database)/documents/authState/$(request.auth.uid)).data.version == request.auth.token.jolVersion;
    }
    function active() { return fullSession() && exists(userPath()) && get(userPath()).data.get('deleting', false) == false; }
    function courier() { return active() && get(userPath()).data.role == 'courier'; }
    function participant(d) { return active() && (d.senderId == request.auth.uid || d.driverId == request.auth.uid); }
    match /users/{uid} {
      allow read: if fullSession() && request.auth.uid == uid;
      allow create, update, delete: if false; // Registration and verified fields are server-owned.
      match /tokens/{tokenId} {
        allow read, delete: if active() && request.auth.uid == uid;
        allow create, update: if active() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token == tokenId
          && tokenId.size() <= 4096 && request.resource.data.updatedAt == request.time;
      }
    }
    match /deliveries/{id} {
      allow read: if participant(resource.data) || (courier() && resource.data.status == 'waiting');
      allow write: if false; // All mutations use authenticated, App Check protected callables.
      match /private/{doc} {
        function order() { return get(/databases/$(database)/documents/deliveries/$(id)).data; }
        function liveAllowed() {
          let lease = get(/databases/$(database)/documents/trackingSessions/$(id)).data;
          let publisher = get(/databases/$(database)/documents/authSessions/$(resource.data.publisherSessionId)).data;
          return order().status in ['enRoute', 'pickedUp'] && resource.data.driverId == order().driverId
            && resource.data.expiresAt > request.time && resource.data.visibleUntil > request.time && lease.active == true && lease.sessionId == resource.data.sessionId
            && publisher.uid == order().driverId && publisher.revoked == false && publisher.expiresAt > request.time
            && publisher.version == resource.data.publisherVersion
            && get(/databases/$(database)/documents/authState/$(order().driverId)).data.version == resource.data.publisherVersion;
        }
        allow read: if participant(order()) && (doc == 'details' || (doc == 'liveLocation' && liveAllowed()));
        allow write: if false;
      }
      match /messages/{message} {
        allow read: if participant(get(/databases/$(database)/documents/deliveries/$(id)).data);
        allow write: if false;
      }
    }
    match /trips/{id} {
      allow read: if active() && (resource.data.driverId == request.auth.uid || (get(userPath()).data.role == 'sender' && resource.data.status == 'published'));
      allow write: if false;
      match /private/{document} {
        allow read: if active() && get(/databases/$(database)/documents/trips/$(id)).data.driverId == request.auth.uid;
        allow write: if false;
      }
    }
    match /proposals/{id} {
      allow read: if active() && (resource.data.senderId == request.auth.uid || resource.data.driverId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
